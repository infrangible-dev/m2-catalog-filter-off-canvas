{
    "name": "infrangible/m2-catalog-filter-off-canvas",
    "description": "Moves the layered navigation filters into a slide-in panel that opens from a \"Filters\" button in the product list toolbar.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Layered navigation",
        "Catalog",
        "off-canvas filters",
        "slide-in layered navigation",
        "filter drawer"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-filter-off-canvas",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.5",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-store": "~101.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogFilterOffCanvas\\": "src"
        }
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    }
}
